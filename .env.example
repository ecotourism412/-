TUJILISHIDAI_API_KEY=your_api_key_here
TUJILISHIDAI_BASE_URL=https://aihubmix.com/v1

# AIHubMix /v1/models 当前未列出 Doubao-1.5-lite-32k；实测 qwen3.6-flash 低延迟且可稳定输出 JSON。
TUJILISHIDAI_MODEL_CABBAGE=qwen3.6-flash
# glm-4.7-flash-free 当前可见，但实测只返回 reasoning_content；普通猪暂用 qwen3.6-flash。
TUJILISHIDAI_MODEL_PIG=qwen3.6-flash
# AIHubMix /v1/models 当前未列出 Doubao-1.5-pro-32k；豆包 pro 替代模型延迟过高，猪王暂用 qwen3.6-flash。
TUJILISHIDAI_MODEL_PIGKING=qwen3.6-flash

TUJILISHIDAI_TIMEOUT_MS=15000
# 本地网络中 Node fetch 访问 AIHubMix 超时时，auto 会用后端 Python urllib 兜底。
TUJILISHIDAI_HTTP_CLIENT=auto
TUJILISHIDAI_PYTHON_BIN=python3

DOUBAO_TTS_ENABLED=true
DOUBAO_TTS_API_KEY=your_doubao_tts_api_key_here
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_RESOURCE_ID=seed-icl-2.0
DOUBAO_TTS_MODEL=seed-tts-2.0-standard
DOUBAO_TTS_VOICE_CABBAGE=PASTE_CABBAGE_VOICE_ID_HERE
DOUBAO_TTS_VOICE_PIG=PASTE_PIG_VOICE_ID_HERE
DOUBAO_TTS_VOICE_PIGKING=PASTE_PIG_VOICE_ID_HERE
DOUBAO_TTS_AUDIO_FORMAT=mp3
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_BIT_RATE=64000
DOUBAO_TTS_TIMEOUT_MS=10000
